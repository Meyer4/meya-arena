// Meya Arena — Firestore security rules (Phase 2: auth/friends/profiles).
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rating', 'banned']);
      allow delete: if false;
    }
    match /friends/{uid}/list/{fid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) || isOwner(fid);
      allow delete: if isOwner(uid) || isOwner(fid);
    }
    match /matchHistory/{matchId} {
      allow read: if signedIn();
      allow write: if false; // server writes via Admin SDK only
    }
  }
}
